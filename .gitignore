# Backup copies of derived data (regenerate, never commit)
data/backups/
data/parquet/*.partial.parquet
data/parquet/*.newrows.parquet

# Build metadata (regenerated by `uv pip install -e .`)
src/*.egg-info/
*.egg-info/

# Keep oversized local optimizer checkpoints out of git/LFS
